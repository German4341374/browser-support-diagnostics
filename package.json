{
  "name": "browser-support-diagnostics",
  "version": "1.0.0",
  "description": "Privacy-first browser extension for collecting local web page diagnostics.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "npm run icons && node scripts/build.mjs",
    "check": "npm run lint && npm run test:coverage && npm run privacy && npm run build",
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "privacy": "node scripts/privacy-check.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.0",
    "globals": "17.8.0",
    "sharp": "0.35.3",
    "vitest": "4.1.10"
  }
}
